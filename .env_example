# Room link. The bot will not start without it.
ROOM_URL=https://meet.example.com/music-room

# Name in the participant list. Empty becomes DJitsi.
BOT_NAME=DJitsi

# off: YouTube directly. on: through YTDLP_PROXY.
USE_PROXY=off

# For Docker, not for the bot.
# Empty: only the bot starts.
# proxy: also start Xray, which reads xray/config.json.
COMPOSE_PROFILES=

# Proxy address. Used only when USE_PROXY=on.
# Leave this commented to use socks5h://xray:1080 (the Xray container).
#
# Your own VLESS:
#   USE_PROXY=on
#   COMPOSE_PROFILES=proxy
#   YTDLP_PROXY=socks5h://xray:1080
#
# A proxy you already have. COMPOSE_PROFILES stays empty.
#   USE_PROXY=on
#   COMPOSE_PROFILES=
#   YTDLP_PROXY=socks5://user:pass@host:1080
#   YTDLP_PROXY=http://host:8080
# YTDLP_PROXY=socks5h://xray:1080
